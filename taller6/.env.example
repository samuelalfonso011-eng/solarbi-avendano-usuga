# PLANTILLA de credenciales. Copiar a .env y cambiar TODOS los valores,
# o generar uno aleatorio con:  bash scripts/generar_env.sh
# El archivo .env real NO se versiona (.gitignore). En Kubernetes su contenido
# se convierte en el Secret "microrred-secretos" al desplegar.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar-por-una-clave-larga
ETL_PASSWORD=cambiar-clave-etl
SIM_PASSWORD=cambiar-clave-simulador
GRAFANA_DB_PASSWORD=cambiar-clave-grafana-solo-lectura
BI_PASSWORD=cambiar-clave-powerbi-solo-lectura
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=cambiar-clave-admin-grafana
