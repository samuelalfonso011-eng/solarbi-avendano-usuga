# Parametros NO sensibles de la solucion. Este archivo alimenta:
#   - el ConfigMap "microrred-config" (kustomize configMapGenerator)
#   - docker-compose (env_file)
# Cambiar un umbral aqui y volver a aplicar NO requiere reconstruir ninguna imagen.

# --- Conexion (nombres, nunca IP) ---
PGHOST=postgres
PGPORT=5432
PGDATABASE=microrred

# --- ETL ---
SQLITE_PATH=/datos/bronze/opencem-v1.0.0.sqlite
ZONA_HORARIA_SITIO=Asia/Shanghai
GAP_MAX_S=600
SOC_BAJO_PCT=15
V_AC_MIN=100
EVENTO_MIN_S=60
BAT_REPOSO_A=0.9
BATERIA_KWH=10.24
CALCULAR_SHA256=1
# Tarifa: EPM, mercado regulado, octubre de 2026, "Oficial y Exentos de Contribucion",
# Nivel I, activos propiedad de EPM (ver docs/02_indicadores.md)
TARIFA_COP_KWH=991.29
TARIFA_VIGENTE_DESDE=2025-01-01
TARIFA_FUENTE=EPM - Tarifas y Costo de Energia Electrica, Mercado Regulado, octubre de 2026 (Oficial y Exentos de Contribucion, Nivel I, propiedad EPM)

# --- Simulador ---
SIM_ESCENARIO=normal
SIM_INVERSOR_ESCENARIO=2
SIM_SOC_FORZADO=8
SIM_DIA_BASE=2026-01-12
SIM_DIAS_CICLO=7
SIM_ZONA_OPERACION=America/Bogota
SIM_INTERVALO_S=60

# --- Umbrales de las alertas de Grafana ---
ALERTA_SOC_BAJO_PCT=15
ALERTA_SIN_DATOS_S=300
ALERTA_RED_ALTA_W=3000
