	partition Energia = m
		mode: import
		source =
				let
				    Origen = PostgreSQL.Database(Servidor, BaseDatos),
				    Tabla = Origen{[Schema="gold", Item="fact_energia_5min"]}[Data]
				in
				    Tabla

