      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pg-microrred"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT 100.0 * SUM(n_validas) / SUM(n_lecturas) AS pct FROM gold.fact_energia_5min"
        }
      ],
