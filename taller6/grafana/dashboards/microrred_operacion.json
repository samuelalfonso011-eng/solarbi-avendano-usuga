    {
      "id": 14,
      "type": "table",
      "title": "Ultimas lecturas recibidas",
      "description": "Cada lectura reproduce un intervalo historico real (columna derecha).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pg-microrred"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pg-microrred"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT ts AS \"Hora\", inversor_id AS \"Inversor\", soc_pct AS \"SOC %\", p_solar_w AS \"Solar W\", p_carga_w AS \"Carga W\", p_red_w AS \"Red W\", p_bateria_w AS \"Bateria W\", red_disponible AS \"Red disponible\", escenario AS \"Escenario\", ts_origen AS \"Intervalo historico reproducido\" FROM live.lectura WHERE $__timeFilter(ts) AND inversor_id IN ($inversor) ORDER BY ts DESC, inversor_id LIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
