    {
      "id": 16,
      "type": "barchart",
      "title": "Energia diaria del ultimo mes con datos (kWh)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pg-microrred"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 14,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pg-microrred"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT to_char(fecha, 'MM-DD') AS dia, SUM(e_solar_kwh) AS \"Solar\", SUM(e_red_kwh) AS \"Red\", SUM(e_carga_kwh) AS \"Carga\" FROM gold.vw_kpi_diario WHERE inversor_id IN ($inversor) AND fecha > (SELECT MAX(fecha) FROM gold.vw_kpi_diario WHERE e_carga_kwh > 0) - 30 AND fecha <= (SELECT MAX(fecha) FROM gold.vw_kpi_diario WHERE e_carga_kwh > 0) GROUP BY fecha ORDER BY fecha"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "xField": "dia",
        "stacking": "none",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "xTickLabelRotation": -45,
        "xTickLabelSpacing": 100
      }
    },
